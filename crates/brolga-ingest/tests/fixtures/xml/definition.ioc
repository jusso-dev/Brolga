<?xml version="1.0" encoding="us-ascii"?>
<ioc xmlns="http://schemas.mandiant.com/2010/ioc" id="9b7a1e40-2c3d-4e5f-8a90-1b2c3d4e5f60" last-modified="2024-01-01T00:00:00">
  <short_description>Dropbear loader indicators</short_description>
  <description>Artefacts observed alongside the Dropbear loader.</description>
  <authored_by>Analyst</authored_by>
  <authored_date>2024-01-01T00:00:00</authored_date>
  <definition>
    <Indicator operator="OR" id="1a2b3c4d-0000-4000-8000-000000000001">
      <IndicatorItem id="ii-1" condition="is">
        <Context document="Network" search="Network/DNS" type="mir"/>
        <Content type="string">C2.EXAMPLE.NET.</Content>
      </IndicatorItem>
      <IndicatorItem id="ii-2" condition="is">
        <Context document="FileItem" search="FileItem/Md5sum" type="mir"/>
        <Content type="md5">bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb</Content>
      </IndicatorItem>
      <IndicatorItem id="ii-3" condition="contains">
        <Context document="ProcessItem" search="ProcessItem/arguments" type="mir"/>
        <Content type="string">-enc</Content>
      </IndicatorItem>
      <IndicatorItem id="ii-4" condition="is">
        <Context document="PortItem" search="PortItem/remoteIP" type="mir"/>
        <Content type="IP">not-an-address</Content>
      </IndicatorItem>
    </Indicator>
  </definition>
</ioc>
