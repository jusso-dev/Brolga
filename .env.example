# Required for `docker compose --profile serve up`
BROLGA_API_TOKEN=replace-with-at-least-16-chars
# Optional: bind API on all interfaces (default is loopback only)
# BROLGA_API_BIND=0.0.0.0
# Primary TI source — OpenCTI API token (never pass as a CLI flag)
# BROLGA_OPENCTI_TOKEN=
# Optional TAXII bearer token for secondary STIX collections
# BROLGA_TAXII_TOKEN=
# Required for postgres overlay (docker-compose.postgres.yml)
# BROLGA_POSTGRES_PASSWORD=change-me
